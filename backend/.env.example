# ── Aurelia Logistics Backend ──
# Copy this to .env and fill in your values

# App
APP_NAME=Aurelia Logistics API

# Deployment environment: local | staging | production
ENV=local

# Debug is opt-in and is REJECTED at startup when ENV=production, because it
# enables SQLAlchemy statement logging (writes customer PII to the log) and
# exposes /docs, /redoc and /openapi.json.
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (SQLite by default — swap to PostgreSQL when ready)
DATABASE_URL=sqlite:///./aurelia.db

# Email notifications (SMTP)
# SMTP_USER, SMTP_PASSWORD and NOTIFICATION_EMAIL are OPTIONAL when ENV=local
# (the notifier logs a warning and skips the send) but MANDATORY when ENV is
# staging or production — otherwise enquiries are accepted and the notification
# is silently dropped. Startup fails if they are missing there.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-sending-address@domain.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=where-enquiries-should-land@domain.com

# Admin API key — REQUIRED in every environment, no default.
# Guards every endpoint that returns customer personal data
# (GET /api/quotes/, GET /api/contact/ and the admin PATCH routes).
# Must carry at least 32 bytes of entropy or startup fails.
#   generate with:  openssl rand -hex 32
API_KEY=

# Rate limiting (public submission endpoints — per IP per minute)
RATE_LIMIT_PER_MINUTE=5
