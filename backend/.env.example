# ── Aurelia Logistics Backend ──
# Copy this to .env and fill in your values

# App
APP_NAME=Aurelia Logistics API
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (SQLite by default — swap to PostgreSQL when ready)
DATABASE_URL=sqlite:///./aurelia.db

# Email notifications (SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-sending-address@domain.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=

# Admin API key — set a strong random value (e.g. openssl rand -hex 32)
# Required to access GET /api/quotes/, GET /api/contact/, and all write endpoints for products
API_KEY=

# Rate limiting (public submission endpoints — per IP per minute)
RATE_LIMIT_PER_MINUTE=5
