# Secrets — never commit real credentials. Use .env.example as the template.
.env
.env.*
!.env.example

# Virtualenv
venv/
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Test / coverage artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Local database — contains customer PII, must never be committed
*.db
*.sqlite
*.sqlite3
